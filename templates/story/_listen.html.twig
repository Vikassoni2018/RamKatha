{# Inline listening card. It controls the global (persistent) player via events. The narration is always Hindi. #}
{% set audio = story.currentAudio %}
{% if story.hasPlayableAudio %}
    {% set startAt = progress is defined and progress and progress.isResumable ? progress.audioPositionSeconds : 0 %}
    {% set uid = story.uuid.toRfc4122 %}
    <section id="listen" class="listen-card" aria-labelledby="listen-title-{{ uid }}"
             data-controller="story-player"
             data-story-player-uuid-value="{{ uid }}"
             data-story-player-src-value="{{ path('app_audio_stream', {uuid: audio.uuid.toRfc4122}) }}"
             data-story-player-title-value="{{ story|localized('title') }}"
             data-story-player-url-value="{{ path('app_story_show', {slug: story.slug}) }}"
             data-story-player-cover-value="{{ story.coverImage ? media_url(story.coverImage, 'thumb') : '' }}"
             data-story-player-duration-value="{{ audio.durationSeconds }}"
             data-story-player-start-at-value="{{ startAt }}"
             data-action="keydown->story-player#keydown">
        <div class="listen-card-top">
            <button type="button" class="play-button" aria-label="{{ 'listen.play'|trans }}" aria-pressed="false"
                    data-story-player-target="playButton" data-action="story-player#toggle">
                <span data-story-player-target="playIcon">{{ icon('play', 'icon-play') }}</span>
                <span data-story-player-target="pauseIcon" hidden>{{ icon('pause') }}</span>
            </button>
            <div>
                <h2 class="listen-card-title" id="listen-title-{{ uid }}">{{ 'listen.title'|trans }}</h2>
                <p class="listen-card-sub">{{ 'listen.hindi_narration'|trans }} · {{ audio.durationSeconds|duration_words }}{% if story.audioOutdated %} · {{ 'listen.audio_outdated'|trans }}{% endif %}</p>
                <p class="resume-hint mb-0" hidden data-story-player-target="resume">{{ icon('clock', 'icon-sm') }} {{ 'listen.resume_hint'|trans({'%time%': startAt|duration}) }}</p>
            </div>
        </div>
        <div class="player-controls">
            <div class="player-row">
                <span class="time" data-story-player-target="current">0:00</span>
                <label class="visually-hidden" for="seek-{{ uid }}">{{ 'listen.position'|trans }}</label>
                <input id="seek-{{ uid }}" class="range" type="range" min="0" max="{{ audio.durationSeconds }}" step="1" value="{{ startAt }}"
                       data-story-player-target="seek" data-action="input->story-player#seek">
                <span class="time" data-story-player-target="total">{{ audio.durationSeconds|duration }}</span>
            </div>
            <div class="player-row spread">
                <div class="player-row">
                    <button type="button" class="player-btn" aria-label="{{ 'listen.back_10'|trans }}" data-action="story-player#back">{{ icon('rewind-10') }}</button>
                    <button type="button" class="player-btn" aria-label="{{ 'listen.forward_10'|trans }}" data-action="story-player#forward">{{ icon('forward-10') }}</button>
                    <label class="visually-hidden" for="speed-{{ uid }}">{{ 'listen.speed'|trans }}</label>
                    <select id="speed-{{ uid }}" class="speed-select" data-story-player-target="speed" data-action="change->story-player#rate">
                        {% for rate in [0.75, 1, 1.25, 1.5, 2] %}<option value="{{ rate }}" {% if rate == 1 %}selected{% endif %}>{{ rate }}x</option>{% endfor %}
                    </select>
                </div>
                <div class="player-row volume-group">
                    <button type="button" class="player-btn" aria-label="{{ 'listen.mute'|trans }}" data-action="story-player#mute">
                        <span data-story-player-target="unmuteIcon">{{ icon('volume') }}</span>
                        <span data-story-player-target="muteIcon" hidden>{{ icon('volume-x') }}</span>
                    </button>
                    <label class="visually-hidden" for="volume-{{ uid }}">{{ 'listen.volume'|trans }}</label>
                    <input id="volume-{{ uid }}" class="range volume-range" type="range" min="0" max="1" step="0.05" value="1"
                           data-story-player-target="volume" data-action="input->story-player#volume">
                </div>
            </div>
        </div>
        <span class="visually-hidden" aria-live="polite" data-story-player-target="status"></span>
    </section>
{% elseif story.audioEnabled and story.audioStatus and story.audioStatus.isInProgress %}
    <div class="audio-unavailable" role="status">{{ icon('mic') }} {{ 'listen.in_progress'|trans }}</div>
{% endif %}
