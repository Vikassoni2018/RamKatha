{# Admin-specific form widgets on top of the base theme. #}
{% use 'form/app_theme.html.twig' %}

{# Media picker: hidden id + preview + library dialog + upload. #}
{%- block media_picker_widget -%}
    {%- set media = value ? media_by_id(value) : null -%}
    <div data-controller="media-picker"
         data-media-picker-list-url-value="{{ path('admin_media_api') }}"
         data-media-picker-upload-url-value="{{ path('admin_media_upload_api') }}">
        <input type="hidden" {{ block('widget_attributes') }} value="{{ value }}" data-media-picker-target="input">
        <div class="media-picker-preview" data-media-picker-target="preview">
            {%- if media -%}
                <img src="{{ media_url(media, 'thumb') }}" alt=""><span class="text-xs text-muted">{{ media.originalName }}</span>
            {%- else -%}
                <span class="placeholder">No image</span>
            {%- endif -%}
        </div>
        <div class="cluster mt-4">
            <button type="button" class="btn btn-sm" data-action="media-picker#open">{{ icon('image', 'icon-sm') }} Choose from library</button>
            <button type="button" class="btn btn-sm btn-ghost" data-action="media-picker#clear">Remove</button>
        </div>
        <dialog class="modal modal-wide" aria-label="Media library" data-media-picker-target="dialog" data-action="click->media-picker#backdrop">
            <div class="modal-header">
                <h2>Media library</h2>
                <button type="button" class="btn btn-ghost btn-icon" aria-label="Close" data-action="media-picker#close">{{ icon('close') }}</button>
            </div>
            <div class="modal-body stack">
                <div class="cluster">
                    <input type="search" class="form-control grow" placeholder="Search images…" aria-label="Search images" data-media-picker-target="search" data-action="input->media-picker#search">
                    <label class="btn btn-sm btn-secondary">{{ icon('upload', 'icon-sm') }} Upload new
                        <input type="file" accept="image/jpeg,image/png,image/webp" class="visually-hidden" data-media-picker-target="file" data-action="change->media-picker#upload">
                    </label>
                </div>
                <p class="text-sm text-muted" role="status" data-media-picker-target="status"></p>
                <div class="media-grid" data-media-picker-target="grid"></div>
                <button type="button" class="btn btn-sm" hidden data-media-picker-target="more" data-action="media-picker#more">Load more</button>
            </div>
        </dialog>
    </div>
{%- endblock media_picker_widget -%}

{# Collection rows (source references) with add/remove. #}
{%- block collection_widget -%}
    {%- if prototype is defined and not prototype.rendered -%}
        <div data-controller="form-collection" data-form-collection-index-value="{{ form|length > 0 ? form|last.vars.name + 1 : 0 }}">
            <div data-form-collection-target="list">
                {%- for child in form -%}
                    {{- block('collection_entry') -}}
                {%- endfor -%}
            </div>
            <template data-form-collection-target="template">
                {%- set child = prototype -%}
                {{- block('collection_entry') -}}
            </template>
            <button type="button" class="btn btn-sm btn-secondary" data-action="form-collection#add">{{ icon('plus', 'icon-sm') }} {{ form.vars.attr['data-add-label']|default('Add') }}</button>
        </div>
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock collection_widget -%}

{%- block collection_entry -%}
    <div class="collection-entry" data-collection-entry>
        <div class="collection-entry-header">
            <span>{{ form.vars.attr['data-entry-label']|default('Item') }}</span>
            <button type="button" class="btn btn-ghost btn-sm" data-action="form-collection#remove">{{ icon('trash', 'icon-sm') }} Remove</button>
        </div>
        {{- form_widget(child) -}}
        {{- form_errors(child) -}}
    </div>
{%- endblock collection_entry -%}
