<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject|default(site_name) }}</title>
</head>
<body style="margin:0;padding:0;background:#fbf7f0;font-family:'Noto Sans Devanagari','Nirmala UI','Mangal',Arial,sans-serif;color:#2b1d16;line-height:1.7">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fbf7f0;padding:24px 12px">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #eadfcf;border-radius:16px;overflow:hidden">
                <tr>
                    <td style="background:#7a1f2b;color:#ffe9cc;padding:18px 28px;font-size:20px;font-weight:700">🪔 {{ site_name }}</td>
                </tr>
                <tr>
                    <td style="padding:28px">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:18px 28px;border-top:1px solid #efe6d8;font-size:12px;color:#776558">
                        {{ 'email.footer'|trans({'%site_name%': site_name}) }}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
