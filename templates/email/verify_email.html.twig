{% extends 'email/_layout.html.twig' %}

{% block content %}
    <h1 style="font-size:22px;margin:0 0 12px">{{ 'email.greeting'|trans({'%name%': user.displayName}) }}</h1>
    <p style="margin:0 0 16px">{{ 'email.verify.intro'|trans({'%site_name%': site_name}) }}</p>
    <p style="margin:24px 0">
        <a href="{{ url }}" style="display:inline-block;padding:12px 24px;border-radius:999px;background:#7a1f2b;color:#ffffff;text-decoration:none;font-weight:700">{{ 'email.verify.button'|trans }}</a>
    </p>
    <p style="margin:0 0 8px;font-size:13px;color:#66554a">{{ 'email.verify.validity'|trans({'%hours%': hours}) }}</p>
    <p style="margin:0;font-size:12px;word-break:break-all;color:#7a1f2b">{{ url }}</p>
{% endblock %}
