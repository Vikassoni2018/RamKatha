{% extends 'admin/layout.html.twig' %}
{% import 'admin/_chart.html.twig' as chart %}
{% import 'admin/_macros.html.twig' as ui %}

{% block title %}Analytics{% endblock %}
{% block breadcrumbs %}<li><span aria-current="page">Analytics</span></li>{% endblock %}

{% block body %}
<div class="admin-page-header">
    <div><h1>Analytics</h1><p>First-party, aggregated daily counters — no cookies, no third-party trackers. {{ report.from|date('d M Y') }} – {{ report.to|date('d M Y') }}</p></div>
    <div class="actions">
        {% for d in [7, 30, 90, 365] %}<a class="chip {{ days == d ? 'is-active' }}" href="{{ path('admin_analytics', {days: d, order: order}) }}">{{ d }} days</a>{% endfor %}
        <a class="btn btn-sm" href="{{ path('admin_analytics_export', {days: days}) }}" data-turbo="false">{{ icon('download', 'icon-sm') }} CSV</a>
    </div>
</div>

<div class="stat-grid">
    {% for key, label in {views: 'Story views', unique_views: 'Unique (approx.)', audio_starts: 'Audio plays', audio_completions: 'Completed listens', bookmarks: 'Bookmarks', collection_adds: 'Added to collections', shares: 'Shares', donations_declared: 'Contributions declared'} %}
        <div class="stat-card"><span class="stat-label">{{ label }}</span><span class="stat-value">{{ report.totals[key]|default(0)|number_format }}</span></div>
    {% endfor %}
</div>

<section class="card mb-6"><div class="card-body">{{ chart.daily(report.series, 'Daily views and listens') }}</div></section>

<section class="card" aria-labelledby="top-title">
    <div class="card-header">
        <h2 id="top-title">Top stories</h2>
        <nav class="cluster" aria-label="Sort">{% for o, l in {views: 'Views', audio_starts: 'Plays', audio_completions: 'Completions', shares: 'Shares', bookmarks: 'Bookmarks'} %}<a class="chip {{ order == o ? 'is-active' }}" href="{{ path('admin_analytics', {days: days, order: o}) }}">{{ l }}</a>{% endfor %}</nav>
    </div>
    {% if report.top is not empty %}
        <table class="admin-table">
            <thead><tr><th>Story</th><th class="num">Views</th><th class="num">Unique≈</th><th class="num">Plays</th><th class="num">Completed</th><th class="num">Completion rate</th><th class="num">Bookmarks</th><th class="num">Shares</th></tr></thead>
            <tbody>
                {% for r in report.top %}
                    <tr>
                        <td class="cell-main" data-label="Story"><a class="cell-title" href="{{ path('admin_story_edit', {id: r.id}) }}">{{ r.title }}</a></td>
                        <td class="num" data-label="Views">{{ r.views|number_format }}</td>
                        <td class="num" data-label="Unique">{{ r.unique_views|number_format }}</td>
                        <td class="num" data-label="Plays">{{ r.audio_starts|number_format }}</td>
                        <td class="num" data-label="Completed">{{ r.audio_completions|number_format }}</td>
                        <td class="num" data-label="Rate">{{ r.audio_starts > 0 ? (r.audio_completions / r.audio_starts * 100)|round ~ '%' : '—' }}</td>
                        <td class="num" data-label="Bookmarks">{{ r.bookmarks|number_format }}</td>
                        <td class="num" data-label="Shares">{{ r.shares|number_format }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="card-body"><p class="text-muted mb-0">No data for this period yet.</p></div>
    {% endif %}
</section>
<p class="text-xs text-subtle mt-4">Popularity (used for “इन दिनों लोकप्रिय”) = activity of the last 14 days weighted by recency (7-day half-life): views + 2×plays + 4×completions + 5×bookmarks + 3×collection adds + 3×shares. Recomputed hourly.</p>
{% endblock %}
