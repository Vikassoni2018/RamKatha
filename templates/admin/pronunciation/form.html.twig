{% extends 'admin/layout.html.twig' %}
{% form_theme form 'form/admin_theme.html.twig' %}

{% block title %}{{ isNew ? 'New rule' : rule.sourceText }}{% endblock %}
{% block breadcrumbs %}<li><a href="{{ path('admin_pronunciation_index') }}">Pronunciation</a></li><li><span aria-current="page">{{ isNew ? 'New rule' : rule.sourceText }}</span></li>{% endblock %}

{% block body %}
<div class="admin-page-header"><div><h1>{{ isNew ? 'New pronunciation rule' : 'Edit rule' }}</h1></div></div>
<div class="panel-grid">
    <div class="card"><div class="card-body">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="form-row form-row-2">{{ form_row(form.sourceText) }}{{ form_row(form.replacementText) }}</div>
            <div class="form-row form-row-2">{{ form_row(form.language) }}{{ form_row(form.priority) }}</div>
            {{ form_rest(form) }}
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">{{ icon('check', 'icon-sm') }} Save</button>
                <a class="btn btn-ghost" href="{{ path('admin_pronunciation_index') }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div></div>
    <aside><twig:PronunciationPreview /></aside>
</div>
{% endblock %}
