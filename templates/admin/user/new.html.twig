{% extends 'admin/layout.html.twig' %}
{% form_theme form 'form/admin_theme.html.twig' %}

{% block title %}New staff account{% endblock %}
{% block breadcrumbs %}<li><a href="{{ path('admin_user_index') }}">Users</a></li><li><span aria-current="page">New staff account</span></li>{% endblock %}

{% block body %}
<div class="admin-page-header"><div><h1>New staff account</h1><p>Readers register themselves; use this for authors, reviewers, editors and admins.</p></div></div>
<div class="card"><div class="card-body">
    {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-turbo': 'false'}}) }}
        <div class="form-row form-row-2">{{ form_row(form.displayName) }}{{ form_row(form.email) }}</div>
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.assignedRoles) }}
        <div class="form-actions"><button class="btn btn-primary" type="submit">Create account</button><a class="btn btn-ghost" href="{{ path('admin_user_index') }}">Cancel</a></div>
    {{ form_end(form) }}
</div></div>
{% endblock %}
