{#
  Generic error page (500 and others). Deliberately standalone: it must render even when the
  database or other services are the cause of the error. No technical details are shown.
  The language follows the URL (/en/... is English, see LocaleSubscriber); only the translator is used.
#}
{% set home_url = app.locale == 'en' ? '/en' : '/' %}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ (status_code == 503 ? 'error.maintenance.title' : 'error.generic.title')|trans }}</title>
    <style>
        body{margin:0;min-height:100vh;display:grid;place-items:center;padding:1.5rem;background:#fbf7f0;color:#2b1d16;font-family:"Noto Sans Devanagari","Nirmala UI","Mangal",system-ui,sans-serif;line-height:1.7;text-align:center}
        main{max-width:34rem}
        .code{font-family:"Noto Serif Devanagari",Georgia,serif;font-size:4.5rem;line-height:1;color:#7a1f2b;margin:0 0 1rem}
        h1{font-family:"Noto Serif Devanagari",Georgia,serif;font-size:1.6rem;margin:0 0 .75rem}
        p{color:#66554a}
        a{display:inline-block;margin-top:1rem;padding:.7rem 1.4rem;border-radius:999px;background:#7a1f2b;color:#fff;text-decoration:none;font-weight:600}
        a:focus-visible{outline:3px solid #e07a1f;outline-offset:2px}
    </style>
</head>
<body>
<main>
    <p class="code" aria-hidden="true">{{ status_code }}</p>
    {% if status_code == 503 %}
        <h1>{{ 'error.maintenance.title'|trans }}</h1>
        <p>{{ 'error.maintenance.text'|trans }}</p>
    {% else %}
        <h1>{{ 'error.generic.title'|trans }}</h1>
        <p>{{ 'error.generic.text'|trans }}</p>
    {% endif %}
    <a href="{{ home_url }}">{{ 'error.go_home'|trans }}</a>
</main>
</body>
</html>
