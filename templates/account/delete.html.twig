{% extends 'account/_layout.html.twig' %}

{% block account_body %}
<h1 class="mb-6">{{ 'account.delete.title'|trans }}</h1>
<div class="card">
    <div class="card-body">
        {% include 'partials/_alert.html.twig' with {type: 'warning', message: 'account.delete.warning'|trans} only %}
        {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-turbo': 'false', 'data-controller': 'confirm', 'data-confirm-message-value': 'account.delete.confirm_message'|trans, 'data-confirm-title-value': 'account.delete.title'|trans, 'data-confirm-confirm-label-value': 'account.delete.confirm_yes'|trans, 'data-confirm-cancel-label-value': 'account.cancel'|trans, 'data-confirm-danger-value': 'true', 'data-action': 'submit->confirm#ask'}}) }}
            {{ form_row(form.password) }}
            {{ form_row(form.confirm) }}
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">{{ 'account.delete.submit'|trans }}</button>
                <a class="btn btn-ghost" href="{{ path('app_account') }}">{{ 'account.cancel'|trans }}</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
