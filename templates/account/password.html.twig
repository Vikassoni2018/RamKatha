{% extends 'account/_layout.html.twig' %}

{% block account_body %}
<h1 class="mb-6">{{ 'account.password.title'|trans }}</h1>
<div class="card">
    <div class="card-body">
        {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-turbo': 'false'}}) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.plainPassword) }}
            <div class="form-actions"><button type="submit" class="btn btn-primary">{{ 'account.password.submit'|trans }}</button></div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
