{% extends 'base.html.twig' %}

{% block body %}
<div class="container auth-wrap">
    <div class="card auth-card">
        <div class="card-body">
            <h1>{{ 'auth.forgot.title'|trans }}</h1>
            <p class="lead">{{ 'auth.forgot.lead'|trans }}</p>
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_row(form.email) }}
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-block">{{ 'auth.forgot.submit'|trans }}</button>
                </div>
            {{ form_end(form) }}
            <p class="auth-footer"><a href="{{ path('app_login') }}">{{ 'auth.forgot.back_to_login'|trans }}</a></p>
        </div>
    </div>
</div>
{% endblock %}
