# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Put real values in .env.local (uncommitted) or use `php bin/console secrets:set`.
# See README.md -> "Configuration" for a description of every variable.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> application ###
# Canonical public URL of the site (no trailing slash). Used for canonical URLs, sitemaps,
# OpenGraph, emails and social posts. MUST be set correctly in production.
SITE_URL=http://localhost:8000
# Timezone used to DISPLAY dates. All dates are stored in UTC.
APP_TIMEZONE=Asia/Kolkata
# Public media directory (served by the web server). Must live under public/.
APP_MEDIA_DIR=%kernel.project_dir%/public/media
# URL path prefix under which APP_MEDIA_DIR is served.
APP_MEDIA_URL_PREFIX=/media
# Private storage (audio, temp chunks, exports). Must NOT be web accessible.
APP_STORAGE_DIR=%kernel.project_dir%/var/storage
# Store the client IP address in audit logs (set to 0 if not appropriate for your jurisdiction).
AUDIT_LOG_STORE_IP=1
# Optional: let Apache mod_xsendfile / nginx X-Accel serve audio files ("1" to enable, see README).
APP_X_SENDFILE=0
###< application ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MySQL 8 (production target):
# DATABASE_URL="mysql://ramkatha:CHANGE_ME@127.0.0.1:3306/ramkatha?serverVersion=8.0.36&charset=utf8mb4"
# MariaDB (e.g. XAMPP local development):
# DATABASE_URL="mysql://root:@127.0.0.1:3306/ramkatha?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://ramkatha:CHANGE_ME@127.0.0.1:3306/ramkatha?serverVersion=8.0.36&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Database-backed queue. No Redis/RabbitMQ required.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Local file locks (single server).
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
# null://null disables sending. Example SMTP: smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.com
MAILER_FROM_NAME="Katha"
###< symfony/mailer ###

###> text-to-speech ###
# none | local | http
TTS_PROVIDER=none
# local provider: path to a command-line TTS engine (e.g. piper, espeak-ng).
TTS_BINARY_PATH=
# Arguments template for the local engine. Placeholders: {input} {output} {voice} {language}
# Without {input} the text is sent on the engine's standard input. Paths must not contain spaces.
# espeak-ng example:  -v {voice} -f {input} -w {output}             (TTS_VOICE=hi)
# piper example:      --model {voice} --output_file {output}         (TTS_VOICE=/opt/piper/voices/<hindi-voice>.onnx)
TTS_BINARY_ARGS="-v {voice} -f {input} -w {output}"
TTS_VOICE=hi
TTS_LANGUAGE=hi-IN
# Format produced by the engine for each chunk (wav or mp3).
TTS_OUTPUT_FORMAT=wav
# Seconds allowed per chunk.
TTS_TIMEOUT=300
# Maximum characters per synthesis chunk.
TTS_CHUNK_MAX_CHARS=900
# http provider: an HTTP endpoint that accepts JSON {text, voice, language, format} and returns audio bytes.
TTS_HTTP_ENDPOINT=
TTS_HTTP_API_KEY=
###< text-to-speech ###

###> ffmpeg ###
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AUDIO_BITRATE=64k
# Optional audiogram (social video) generation via FFmpeg.
AUDIOGRAM_ENABLED=0
###< ffmpeg ###

###> facebook ###
FACEBOOK_ENABLED=0
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v23.0
###< facebook ###

###> upi ###
# Defaults; can be overridden in Admin -> Settings.
UPI_ID=
UPI_PAYEE_NAME=
###< upi ###
