# Production configuration template. Copy to /var/www/katha/.env.local (chmod 640, owner deploy:www-data)
# and fill in real values — never commit the result. Alternatively store secrets in the Symfony vault:
#   php bin/console secrets:set FACEBOOK_ACCESS_TOKEN --env=prod
# then run: composer dump-env prod   (compiles .env files into .env.local.php for speed)

APP_ENV=prod
APP_DEBUG=0
# 32+ random characters: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

SITE_URL=https://katha.example.org
DEFAULT_URI=https://katha.example.org
APP_TIMEZONE=Asia/Kolkata
# Only when running behind a reverse proxy / load balancer (comma separated IPs or REMOTE_ADDR):
# TRUSTED_PROXIES=127.0.0.1

DATABASE_URL="mysql://katha:CHANGE_ME@127.0.0.1:3306/katha?serverVersion=8.0.36&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock

# Storage (defaults shown). APP_STORAGE_DIR must NOT be web accessible.
APP_MEDIA_DIR=%kernel.project_dir%/public/media
APP_MEDIA_URL_PREFIX=/media
APP_STORAGE_DIR=%kernel.project_dir%/var/storage
# 1 = let the web server stream narration files (see docs/deploy/apache-vhost.conf / nginx.conf)
APP_X_SENDFILE=0
# Store client IPs in the audit log (0 to disable where not appropriate)
AUDIT_LOG_STORE_IP=1

MAILER_DSN=smtp://USER:PASSWORD@smtp.example.org:587
MAILER_FROM=no-reply@katha.example.org
MAILER_FROM_NAME="कथामृत"

# Text-to-speech: none | local | http   (see README → "Audio narration")
TTS_PROVIDER=local
TTS_BINARY_PATH=/opt/piper/piper
TTS_BINARY_ARGS="--model {voice} --output_file {output}"
TTS_VOICE=/opt/piper/voices/hindi-voice.onnx
TTS_LANGUAGE=hi-IN
TTS_OUTPUT_FORMAT=wav
TTS_TIMEOUT=300
TTS_CHUNK_MAX_CHARS=900
# TTS_PROVIDER=http
# TTS_HTTP_ENDPOINT=http://127.0.0.1:5002/synthesize
# TTS_HTTP_API_KEY=

FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
AUDIO_BITRATE=64k
AUDIOGRAM_ENABLED=0

# Facebook Page publishing (long-lived Page access token with pages_manage_posts + pages_read_engagement)
FACEBOOK_ENABLED=0
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v23.0

# Voluntary UPI support (can also be set in Admin → Settings → Donations)
UPI_ID=yourtrust@bank
UPI_PAYEE_NAME="Your Trust Name"
